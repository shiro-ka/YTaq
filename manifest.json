{
  "manifest_version": 2,
  "name": "YTaq",
  "version": "1.4",
  "description": "Custom YT theme + 軽量化.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ytaq@shiro-ka",
      "strict_min_version": "125.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://github.com/shiro-ka/YTaq/releases/download/dev/updates.json"
    }
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.ytimg.com/*"
  ],
  "background": {
    "scripts": [
      "core/ytaq-settings.js",
      "background/ytaq-main.js",
      "background/ytaq-embed-referer.js",
      "background/ytaq-thumbnail-replace.js",
      "background/ytaq-feed.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "core/ytaq-settings.js",
        "core/ytaq-color.js",
        "theme/ytaq-theme.js",
        "core/ytaq-core.js",
        "core/ytaq-innertube.js",
        "core/ytaq-icons.js",
        "core/ytaq-channels.js",
        "rate/ytaq-music.js",
        "perf/ytaq-perf.js",
        "content.js",
        "folder/ytaq-folder-store.js",
        "folder/ytaq-folder-ui.js",
        "subscriptions/ytaq-feed-view.js",
        "subscriptions/ytaq-subs-fetch.js",
        "popup/ytaq-history.js",
        "popup/ytaq-popup-info.js",
        "popup/ytaq-popup-comments.js",
        "popup/ytaq-popup.js",
        "home/ytaq-home.js",
        "home/ytaq-card-collab.js",
        "watch/ytaq-watch.js",
        "rate/ytaq-rate-manager.js",
        "rate/ytaq-rate-ui.js",
        "title/ytaq-title.js",
        "mute/ytaq-mute.js"
      ],
      "css": [
        "ytaq-palette.css",
        "ytaq-variables.css",
        "ytaq-style.css",
        "perf/ytaq-perf.css",
        "popup/ytaq-popup.css",
        "home/ytaq-home.css",
        "home/ytaq-search.css",
        "home/ytaq-compact.css",
        "home/ytaq-card-header.css",
        "watch/ytaq-watch.css",
        "subscriptions/ytaq-feed-view.css",
        "folder/ytaq-folder.css",
        "rate/ytaq-rate-manager.css",
        "mute/ytaq-mute.css"
      ],
      "all_frames": false,
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_icon": {
      "48": "icons/icon48.png"
    },
    "default_title": "YTaq"
  },
  "web_accessible_resources": [
    "icons/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
