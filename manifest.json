{
  "manifest_version": 2,
  "name": "YTaq",
  "version": "1.1.0",
  "description": "Custom YT theme + 軽量化.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ytaq@shiro-ka",
      "strict_min_version": "125.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.ytimg.com/*"
  ],
  "background": {
    "scripts": [
      "background/ytaq-main.js",
      "background/ytaq-embed-referer.js",
      "background/ytaq-thumbnail-replace.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "core/ytaq-core.js",
        "perf/ytaq-perf.js",
        "options/apply-options.js",
        "content.js",
        "folder/ytaq-folder-manager.js",
        "folder/ytaq-folder-ui.js",
        "subscriptions/ytaq-subs-folder.js",
        "popup/ytaq-history.js",
        "popup/ytaq-popup.js",
        "home/ytaq-home.js",
        "rate/ytaq-rate-manager.js",
        "rate/ytaq-rate-ui.js",
        "title/ytaq-title.js"
      ],
      "css": [
        "ytaq-variables.css",
        "ytaq-style.css",
        "perf/ytaq-perf.css",
        "popup/ytaq-popup.css",
        "home/ytaq-home.css",
        "subscriptions/ytaq-subs.css",
        "folder/ytaq-folder.css",
        "rate/ytaq-rate-manager.css"
      ],
      "all_frames": false,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "core/ytaq-core.js",
        "perf/ytaq-perf.js",
        "popup/ytaq-frame.js"
      ],
      "css": [
        "ytaq-variables.css",
        "perf/ytaq-perf.css",
        "popup/ytaq-frame.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_icon": {
      "48": "icons/icon48.png"
    },
    "default_title": "YTaq"
  },
  "web_accessible_resources": [
    "icons/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
